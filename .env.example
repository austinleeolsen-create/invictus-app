# Safe to expose: identifies your Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Server only. Never prefix this with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=rk_test_REPLACE_IN_YOUR_LOCAL_ENV_OR_VERCEL

# QuickBooks OAuth — all server only.
QBO_CLIENT_ID=REPLACE_FROM_INTUIT_DEVELOPER
QBO_CLIENT_SECRET=REPLACE_FROM_INTUIT_DEVELOPER
QBO_REDIRECT_URI=https://invictus-app-kappa.vercel.app/api/qbo/callback
QBO_ENVIRONMENT=sandbox
QBO_TOKEN_ENCRYPTION_KEY=BASE64_ENCODED_32_BYTE_KEY
